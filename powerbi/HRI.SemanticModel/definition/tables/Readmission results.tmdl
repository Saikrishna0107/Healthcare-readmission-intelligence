/// One row per hospital, condition and fiscal year: Excess Readmission Ratio and whether it counted toward the penalty.
table 'Readmission results'
	lineageTag: 85fd9a73-cbd5-47a4-8f8c-38ba55aa467d

	/// Hospital-condition results with a published Excess Readmission Ratio.
	measure 'Scored results' = COUNT('Readmission results'[excess_readmission_ratio])
		formatString: #,0
		displayFolder: Readmissions
		lineageTag: b6eea1cb-fbcb-4ce6-a1ae-488321ecda24

		annotation MetricFlowMetric = scored_results

	/// Simple average of published ratios; above 1.0 = more readmissions than expected.
	measure 'Average Excess Readmission Ratio' = DIVIDE(SUM('Readmission results'[excess_readmission_ratio]), [Scored results])
		formatString: 0.0000
		displayFolder: Readmissions
		lineageTag: f9145798-9baf-4d3b-808c-08b49dd365b1

		annotation MetricFlowMetric = avg_excess_readmission_ratio

	/// Results with an Excess Readmission Ratio above 1.0.
	measure 'Results worse than expected' = CALCULATE(COUNTROWS('Readmission results'), KEEPFILTERS('Readmission results'[excess_readmission_ratio] > 1))
		formatString: #,0
		displayFolder: Readmissions
		lineageTag: 757c4486-634c-4747-b97b-09706ceb842a

		annotation MetricFlowMetric = results_worse_than_expected

	/// Results above 1.0 / results with a published ratio.
	measure 'Share of results worse than expected' = DIVIDE([Results worse than expected], [Scored results])
		formatString: 0.0%
		displayFolder: Readmissions
		lineageTag: f6f496c0-e4cf-4c43-b4ff-a37d41e1d254

		annotation MetricFlowMetric = share_results_worse_than_expected

	/// Results above the peer group median with at least 25 eligible discharges.
	measure 'Results counting toward the penalty' = CALCULATE(COUNTROWS('Readmission results'), KEEPFILTERS('Readmission results'[counts_toward_penalty] = TRUE()))
		formatString: #,0
		displayFolder: Readmissions
		lineageTag: d96fcf71-67c0-40c8-8d3f-93e56e7d824a

		annotation MetricFlowMetric = results_counting_toward_penalty

	/// Medicare discharges eligible for the readmission measures (payment file).
	measure 'Eligible discharges' = SUM('Readmission results'[eligible_discharges])
		formatString: #,0
		displayFolder: Readmissions
		lineageTag: 5cd0572e-1a7e-43dc-82f9-58aead0b76df

		annotation MetricFlowMetric = eligible_discharges

