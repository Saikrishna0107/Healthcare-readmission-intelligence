/// One row per hospital and fiscal year: HRRP payment reduction, peer group and patient survey scores.
table 'Hospital year'
	lineageTag: a50db59d-c9de-4df9-bc4b-71b168b25ffe

	/// Number of hospitals in the HRRP payment file of the fiscal year.
	measure 'Hospitals in the payment file' = CALCULATE(COUNTROWS('Hospital year'), KEEPFILTERS('Hospital year'[in_payment_file] = TRUE()))
		formatString: #,0
		displayFolder: Penalty
		lineageTag: 82396160-b5b8-4e57-a4ba-ff3b93b209da

		annotation MetricFlowMetric = hospitals_in_payment_file

	/// Hospitals whose Medicare payments were reduced (reduction above 0%).
	measure 'Penalized hospitals' = CALCULATE(COUNTROWS('Hospital year'), KEEPFILTERS('Hospital year'[is_penalized] = TRUE()))
		formatString: #,0
		displayFolder: Penalty
		lineageTag: c9cf807a-a84d-41f4-919a-f867bbf3a5a9

		annotation MetricFlowMetric = penalized_hospitals

	/// Penalized hospitals / hospitals in the payment file.
	measure 'Share of hospitals penalized' = DIVIDE([Penalized hospitals], [Hospitals in the payment file])
		formatString: 0.0%
		displayFolder: Penalty
		lineageTag: 82b4a1f5-73f0-43dc-ac9b-b2d4b4fe9919

		annotation MetricFlowMetric = share_penalized

	/// Average reduction in % of Medicare base payments over ALL hospitals in the payment file, unpenalized ones counted as 0%.
	measure 'Average payment reduction (all hospitals in the file)' = DIVIDE(SUM('Hospital year'[payment_reduction_pct]), [Hospitals in the payment file])
		formatString: 0.00"%"
		displayFolder: Penalty
		lineageTag: 21c61761-99ac-4d6d-ac40-4575bb310440

		annotation MetricFlowMetric = avg_payment_reduction_pct

	/// Average reduction in % over penalized hospitals only.
	measure 'Average payment reduction (penalized hospitals only)' = DIVIDE(SUM('Hospital year'[payment_reduction_pct]), [Penalized hospitals])
		formatString: 0.00"%"
		displayFolder: Penalty
		lineageTag: dc3c3182-5ec8-43a5-858e-6eb68a84ff39

		annotation MetricFlowMetric = avg_payment_reduction_among_penalized_pct

	/// Largest reduction in % (the program caps it at 3%).
	measure 'Largest payment reduction' = MAX('Hospital year'[payment_reduction_pct])
		formatString: 0.00"%"
		displayFolder: Penalty
		lineageTag: 56d0e4be-17f9-4d0d-90b6-d08dbd41c0e5

		annotation MetricFlowMetric = max_payment_reduction_pct

	/// Hospitals whose reduction reached the 3% maximum.
	measure 'Hospitals at the 3% cap' = CALCULATE(COUNTROWS('Hospital year'), KEEPFILTERS('Hospital year'[payment_reduction_pct] >= 3))
		formatString: #,0
		displayFolder: Penalty
		lineageTag: e3f2fada-e84e-4db8-8ef4-14bbc57e2f89

		annotation MetricFlowMetric = hospitals_at_max_penalty

	/// Average 'would recommend the hospital' linear mean score (0-100).
	measure 'Average would-recommend score' = AVERAGE('Hospital year'[recommend_score])
		formatString: 0.0
		displayFolder: Patient survey
		lineageTag: 4527d653-25a7-456e-9628-16d77fc4c74a

		annotation MetricFlowMetric = avg_recommend_score

	/// Average overall hospital rating linear mean score (0-100).
	measure 'Average overall rating score' = AVERAGE('Hospital year'[overall_rating_score])
		formatString: 0.0
		displayFolder: Patient survey
		lineageTag: 28c90a90-bf5c-49d6-821b-cd1f46eb8c43

		annotation MetricFlowMetric = avg_overall_rating_score

	/// Average care transition linear mean score (0-100).
	measure 'Average care transition score' = AVERAGE('Hospital year'[care_transition_score])
		formatString: 0.0
		displayFolder: Patient survey
		lineageTag: 720b1699-5abc-4f71-8752-bcdfac523793

		annotation MetricFlowMetric = avg_care_transition_score

	/// Average discharge information linear mean score (0-100).
	measure 'Average discharge information score' = AVERAGE('Hospital year'[discharge_information_score])
		formatString: 0.0
		displayFolder: Patient survey
		lineageTag: 346228e1-b9ec-413d-b5ee-85780e2ad40c

		annotation MetricFlowMetric = avg_discharge_information_score

